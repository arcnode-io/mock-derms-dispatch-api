# broker File-RBAC identity for this service (platform-api credentials.reference.xml,
# role mock_derms_dispatch_api — SUBSCRIBE dlr_rtu rating only, PUBLISH nothing on the broker
# itself; POST /der-events is a plain HTTP call. Compliance verification does NOT belong on this
# credential — a utility has no business holding broker access at all; ComplianceTracker (direct
# MQTT subscribe to der_dispatch's own topics) was removed 2026-09-21 for exactly that reason. If
# compliance verification comes back, it goes over der-control-api's HTTP surface, not the broker.
MQTT_MOCK_DERMS_DISPATCH_API_PASSWORD=

# Optional — speeds up `make audit-packages` (OWASP dependency-check) past NVD's public rate
# limit. Free signup: https://nvd.nist.gov/developers/request-an-api-key
# Read automatically from this env var (nvdApiKeyEnvironmentVariable in pom.xml) — no CLI flag needed.
NVD_API_KEY=

# ERCOT Public API (developer.ercot.com) — real-time North-zone load (NP3-562-CD, Intra-Hour
# Load Forecast by Weather Zone) for the trigger's dynamic margin. Falls back to synthetic on any
# failure (missing creds, auth error, rate limit), same pattern as ems-analyst-agent's own
# gridstatus.io integration. Registered account username is a fixed constant
# (ErcotTokenClient.USERNAME), not a secret — only the password and subscription key are.
ERCOT_PRIMARY_KEY=
ERCOT_PASSWORD=
